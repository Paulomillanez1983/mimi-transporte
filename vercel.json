{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "destination": "/servicios",
      "permanent": false
    },
    {
      "source": "/cliente",
      "destination": "/servicios",
      "permanent": false
    },
    {
      "source": "/hub-clientes",
      "destination": "/servicios",
      "permanent": false
    },
    {
      "source": "/viaje",
      "destination": "/servicios",
      "permanent": false
    },
    {
      "source": "/viaje/",
      "destination": "/servicios",
      "permanent": false
    },
    {
      "source": "/chofer",
      "destination": "/servicios",
      "permanent": false
    },
    {
      "source": "/chofer/",
      "destination": "/servicios",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/servicios",
      "permanent": false
    },
    {
      "source": "/chofer-panel.html",
      "destination": "/servicios",
      "permanent": false
    },
    {
      "source": "/login-chofer.html",
      "destination": "/servicios",
      "permanent": false
    },
    {
      "source": "/operadores",
      "destination": "/prestador",
      "permanent": false
    },
    {
      "source": "/operadores/",
      "destination": "/prestador",
      "permanent": false
    },
    {
      "source": "/hub-operadores",
      "destination": "/prestador",
      "permanent": false
    },
    {
      "source": "/hub-operadores.html",
      "destination": "/prestador",
      "permanent": false
    },
    {
      "source": "/partners",
      "destination": "/prestador",
      "permanent": false
    },
    {
      "source": "/partners.html",
      "destination": "/prestador",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/hub-clientes.html"
    },
    {
      "source": "/hub-clientes",
      "destination": "/hub-clientes.html"
    },
    {
      "source": "/cliente",
      "destination": "/hub-clientes.html"
    },
    {
      "source": "/viaje",
      "destination": "/mimi-servicios/cliente.html"
    },
    {
      "source": "/operadores",
      "destination": "/mimi-servicios/prestador.html"
    },
    {
      "source": "/chofer",
      "destination": "/mimi-servicios/cliente.html"
    },
    {
      "source": "/privacidad",
      "destination": "/privacidad.html"
    },
    {
      "source": "/terminos",
      "destination": "/terminos.html"
    },
    {
      "source": "/delete-account",
      "destination": "/delete-account.html"
    },
    {
      "source": "/servicios",
      "destination": "/mimi-servicios/cliente.html"
    },
    {
      "source": "/prestador",
      "destination": "/mimi-servicios/prestador.html"
    },
    {
      "source": "/hub-operadores",
      "destination": "/mimi-servicios/prestador.html"
    },
    {
      "source": "/partners",
      "destination": "/mimi-servicios/prestador.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/chofer-panel.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/login-chofer.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/mimi-servicios/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/mimi-servicios/sw-2026.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/mimi-servicios/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
